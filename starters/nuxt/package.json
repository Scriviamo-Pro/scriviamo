{
  "name": "scriviamo-nuxt-starter",
  "private": true,
  "description": "A Nuxt app with Scriviamo: an editor with autosave, and pages rendered on the server",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "PORT=${npm_config_port:-3000} node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\""
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "nuxt": "^4.6.4",
    "scriviamo-vue": "file:../../wrappers/vue",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "version": "1.0.1-beta.17"
}
