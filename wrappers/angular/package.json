{
  "name": "scriviamo-angular",
  "version": "1.0.1-beta.16",
  "description": "Angular components for the Scriviamo editor",
  "scripts": {
    "sync": "node ../sync-shared.mjs",
    "check": "npm run sync && tsc -p tsconfig.json --noEmit",
    "build": "npm run sync && ng-packagr -p ng-package.json -c tsconfig.json"
  },
  "peerDependencies": {
    "@angular/core": ">=17",
    "@angular/forms": ">=17",
    "scriviamo": "*"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "ng-packagr": "^20.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
